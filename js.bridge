public class JSBridge {

    Context ctx;
    WebView web;

    public JSBridge(Context c, WebView w){
        ctx = c;
        web = w;
    }

    @JavascriptInterface
    public void publishPost(String text){
        String cid = IPFSService.addText(text);

        runOnUiThread(() -> {
            web.evaluateJavascript(
              "showPost(" + 
              "'" + text + "','" +
              "https://ipfs.io/ipfs/" + cid + "')",
              null
            );
        });
    }
}
